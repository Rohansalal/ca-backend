/**
 * AWS Elastic Beanstalk Configuration
 * Drop this file in .ebextensions/ folder
 */

option_settings:
  # Node.js Configuration
  aws:elasticbeanstalk:container:nodejs:
    NodeCommand: "npm start"
    NodeVersion: 20.x
    GzipCompression: true
    ProxyServer: nginx
  
  # Environment Type
  aws:elasticbeanstalk:environment:
    EnvironmentType: LoadBalanced
    LoadBalancerType: application
    ServiceRole: aws-elasticbeanstalk-service-role
  
  # Auto Scaling
  aws:autoscaling:launchconfiguration:
    InstanceType: t3.micro
    IamInstanceProfile: aws-elasticbeanstalk-ec2-role
    SecurityGroups: sg-xxxxx  # Replace with your security group
    EC2KeyName: your-keypair  # Replace with your EC2 key pair
  
  aws:autoscaling:asg:
    MinSize: 1
    MaxSize: 4
    Cooldown: 360
  
  # Health Check
  aws:elasticbeanstalk:application:
    Application Healthcheck URL: /health
  
  # Load Balancer Health Check
  aws:elb:healthcheck:
    HealthyThreshold: 3
    Interval: 30
    Timeout: 5
    UnhealthyThreshold: 5
  
  # Application Load Balancer Settings
  aws:elbv2:listener:443:
    Protocol: HTTPS
    SSLCertificateArns: arn:aws:acm:ap-south-1:ACCOUNT:certificate/CERT_ID  # Replace with your ACM certificate ARN
  
  aws:elbv2:listener:80:
    Protocol: HTTP
    Rules: redirect-to-https
  
  # Environment Variables (Use AWS Secrets Manager instead for production)
  aws:elasticbeanstalk:application:environment:
    NODE_ENV: production
    PORT: 5000
  
  # Monitoring
  aws:elasticbeanstalk:cloudwatch:logs:
    StreamLogs: true
    DeleteOnTerminate: false
    RetentionInDays: 7
  
  # Rolling Updates
  aws:elasticbeanstalk:command:
    DeploymentPolicy: Rolling
    BatchSizeType: Percentage
    BatchSize: 50
    Timeout: 600

# Files to configure
files:
  # Nginx Configuration
  "/etc/nginx/conf.d/proxy.conf":
    mode: "000644"
    owner: root
    group: root
    content: |
      client_max_body_size 10M;
      proxy_read_timeout 300;
      proxy_connect_timeout 300;
      proxy_send_timeout 300;

  # Node Process Manager
  "/opt/elasticbeanstalk/tasks/taillogs.d/nodejs-app.conf":
    mode: "000644"
    owner: root
    group: root
    content: |
      /var/log/nodejs/nodejs.log

# Commands to run
commands:
  01_install_dependencies:
    command: "npm install --production"
    cwd: /var/app/current
  
  02_prisma_generate:
    command: "npx prisma generate"
    cwd: /var/app/current
  
  03_run_migrations:
    command: "npx prisma migrate deploy"
    cwd: /var/app/current
    env:
      DATABASE_URL: $DATABASE_URL
