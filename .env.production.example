# ===========================================
# PRODUCTION ENVIRONMENT VARIABLES
# ===========================================
# SECURITY WARNING: Never commit this file to version control!
# Store these values in AWS Secrets Manager or similar service
# ===========================================

# Environment
NODE_ENV=production

# Server Configuration
PORT=5000

# Database Configuration (AWS RDS PostgreSQL)
DATABASE_URL="postgresql://dbadmin:SECURE_PASSWORD@ca-website-prod-db.xxxxxx.ap-south-1.rds.amazonaws.com:5432/ca_production?schema=public&sslmode=require"

# JWT Configuration
JWT_SECRET="generate-a-secure-64-character-random-string-here-use-crypto.randomBytes(32).toString('hex')"
ADMIN_SECRET_KEY="generate-another-secure-64-character-random-string-here"
ADMIN_JWT_EXPIRES="7d"
USER_JWT_EXPIRES="7d"

# Admin Roles
ADMIN_ROLE="ADMIN"
SUPER_ADMIN_ROLE="SUPER_ADMIN"

# AWS Configuration
AWS_ACCESS_KEY_ID="your-aws-access-key-id"
AWS_SECRET_ACCESS_KEY="your-aws-secret-access-key"
AWS_REGION="ap-south-1"
AWS_BUCKET_NAME="ca-website-production-files"

# Razorpay Configuration (LIVE KEYS - NOT TEST)
RAZORPAY_KEY_ID="rzp_live_XXXXXXXXXXXXXXXX"
RAZORPAY_KEY_SECRET="your-razorpay-live-secret-key"
RAZORPAY_WEBHOOK_SECRET="your-razorpay-webhook-secret"

# Email Configuration (AWS SES or Gmail)
EMAIL_SERVICE="ses"  # or "gmail"
EMAIL_USER="noreply@yourdomain.com"
EMAIL_PASS="your-email-password-or-ses-credentials"
EMAIL_FROM="Precision Associates <noreply@yourdomain.com>"

# CORS Configuration
# Add your production frontend URLs (comma-separated)
CORS_ORIGIN="https://yourdomain.com,https://www.yourdomain.com,https://main.d1234abcd.amplifyapp.com"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100  # Stricter in production

# Security
BCRYPT_ROUNDS=12

# Logging
LOG_LEVEL="warn"  # Only log warnings and errors in production
LOG_DIR="./logs"

# Application
APP_NAME="Precision Associates"
APP_ENV="production"

# Monitoring (Optional)
SENTRY_DSN="https://your-sentry-dsn@sentry.io/project-id"

# Redis (Optional - for session management and rate limiting)
# REDIS_URL="redis://ca-prod-redis.xxxxxx.cache.amazonaws.com:6379"
